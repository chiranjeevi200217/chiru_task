# Database: Postgres on Supabase
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Upstash Redis Cache (24h TTL)
UPSTASH_REDIS_REST_URL="https://[YOUR-REDIS-URL].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-REDIS-TOKEN]"

# Anthropic Claude API (Lead scoring explainability)
# Note: LeadLens includes an automated deterministic fallback when this key is not provided.
ANTHROPIC_API_KEY="sk-ant-api03-..."

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
